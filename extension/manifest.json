{
  "manifest_version": 3,
  "name": "Triton Tracker Sync",
  "version": "0.1.0",
  "description": "Finds homework that Canvas's calendar misses (PDFs in modules, Gradescope due dates) and adds it to Triton Tracker.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "offscreen"],
  "host_permissions": [
    "https://canvas.ucsd.edu/*",
    "https://www.gradescope.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.gradescope.com/courses/*"],
      "js": ["shared.js", "gradescope-parse.js", "gradescope-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://triton-canvas-tracker-production.up.railway.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
